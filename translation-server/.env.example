# M2M-100 Translation Server Configuration

# Model settings
MODEL_NAME=facebook/m2m100_418M
FINETUNED_MODEL_PATH=  # Path to fine-tuned LoRA adapter (empty = use base model)
USE_QUANTIZATION=true  # Use 4-bit quantization for memory efficiency
DEVICE=cuda  # cuda or cpu
MAX_LENGTH=256
BATCH_SIZE=8

# Redis settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400  # 24 hours in seconds

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500
RATE_LIMIT_PER_DAY=5000

# Logging
LOG_LEVEL=info  # debug, info, warning, error

# Azure Translator fallback (optional)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=koreacentral
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Gemini fallback (optional)
GEMINI_API_KEY=
